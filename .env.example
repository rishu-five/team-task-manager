# Production environment variables
# Copy this file to .env and fill in your values before deploying

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=team_task_manager

# Backend secrets
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING

# Frontend — set this to your public backend URL
VITE_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8000/api/v1

# Email (optional — for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=Team Task Manager
